<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: the UI is Compose (FreeOTPTheme). It sets the window background
         shown before the first frame and the colors of system UI such as the recents entry. -->
    <style name="FreeOTP" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/freeotp_white_primary</item>
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorAccent">@color/purple_500</item>
    </style>
</resources>
